{
  "name": "@contextractor/apify",
  "version": "0.4.14",
  "private": true,
  "description": "Apify Actor that crawls websites and extracts main-content text. Built on rs-trafilatura and Crawlee.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "pnpm run fix && tsc -p tsconfig.json",
    "fix": "biome check . --fix --unsafe && biome format --write . && biome check .",
    "deploy": "node scripts/deploy.mjs",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check ."
  },
  "dependencies": {
    "@contextractor/crawler": "workspace:*",
    "@contextractor/schema": "workspace:*",
    "apify": "^3.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
