{
  "name": "@contextractor/conversion",
  "version": "0.4.14",
  "private": true,
  "description": "Converts one cleaned-HTML string into Contextractor's txt, markdown, json, and html output formats.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@mixmark-io/domino": "^2.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^6.0.3"
  }
}
