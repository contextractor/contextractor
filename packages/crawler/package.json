{
  "name": "@contextractor/crawler",
  "version": "0.4.14",
  "private": true,
  "description": "Shared Crawlee + Playwright crawler package for Contextractor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm run fix && tsc -p tsconfig.json",
    "fix": "biome check . --fix --unsafe && biome format --write . && biome check .",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run --passWithNoTests",
    "lint": "biome check ."
  },
  "dependencies": {
    "@contextractor/extraction": "workspace:*",
    "@ghostery/adblocker-playwright": "^2.18.1",
    "crawlee": "^3.17.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "cheerio": "1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
