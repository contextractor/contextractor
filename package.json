{
  "name": "contextractor-workspace",
  "private": true,
  "version": "0.4.9",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm run fix && turbo build",
    "lint": "biome check . && pnpm lint:md",
    "fix": "biome check . --fix --unsafe && biome format --write . && biome check . && pnpm fix:md",
    "format": "biome format --write . && pnpm fix:md",
    "check": "biome check . && pnpm lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\" && prettier --check \"**/*.md\"",
    "fix:md": "markdownlint-cli2 --fix \"**/*.md\" && prettier --write \"**/*.md\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@cspell/dict-bash": "^4.2.3",
    "@cspell/dict-en-gb": "^5.0.29",
    "@cspell/dict-git": "^3.1.0",
    "@cspell/dict-rust": "^4.1.2",
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^26.0.0",
    "cspell": "^10.0.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "file-type@>=20.0.0 <=21.3.1": ">=21.3.2",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@<=4.1.1": ">=4.2.0 <5",
      "markdown-it@<=14.1.1": ">=14.2.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
